# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication (CRITICAL: Must be at least 32 characters in production)
JWT_SECRET=aicte_sih_secure_jwt_secret_key_2026_super_secure_random_string

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Persistence Driver: "postgres" | "json"
# Defaults to "postgres" if DATABASE_URL or SUPABASE_DB_URL is set, otherwise "json"
PERSISTENCE_DRIVER=json

# PostgreSQL / Supabase Direct Connection (Required when PERSISTENCE_DRIVER=postgres)
# Example: postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=

# Supabase REST Credentials (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Python Semantic Similarity Service
AI_SERVICE_URL=http://localhost:8000

# Non-loopback AI is denied unless an operator explicitly approves external case-data processing.
AI_EXTERNAL_DATA_APPROVED=false
SIMILARITY_MODE=auto
AI_TIMEOUT_MS=1200
# Optional shared secret for a sidecar configured with the same AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=
# Identity AES-256-GCM: supply a secret file containing {"key-id":"base64-32-byte-key"}.
# Keep old keys during rotation; never commit the file. No development key is generated automatically.
IDENTITY_KEYS_FILE=
IDENTITY_ACTIVE_KEY_ID=
# Alternative secret injection: IDENTITY_KEYS_JSON (do not commit actual keys).
# Optional path to an independently protected exported audit-checkpoint.json (read-only).
# Internal database checkpoints alone cannot detect a complete database rewrite.
AUDIT_CHECKPOINT_FILE=

# Email/SMS are disabled by default. development simulates attempts outside production only.
# No live adapters are configured; simulated never means delivered.
NOTIFICATION_DELIVERY_MODE=disabled
